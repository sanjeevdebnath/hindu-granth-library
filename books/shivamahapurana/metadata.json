{
  "id": "shivamahapurana",
  "title": "शिवमहापुराण",
  "description": "शिवमहापुराण का अध्याय-दर-अध्याय डिजिटल पाठ।",
  "sections": [
    {
      "id": "mahatmya",
      "title": "माहात्म्य",
      "chapters": [
        {
          "id": "chapter-01",
          "number": 1,
          "title": "शौनकजीके साधनविषयक प्रश्न करनेपर सूतजीका उन्हें शिवमहापुराणकी महिमा सुनाना"
        },
        {
          "id": "chapter-02",
          "number": 2,
          "title": "शिवपुराणके श्रवणसे देवराजको शिवलोककी प्राप्ति"
        },
        {
          "id": "chapter-03",
          "number": 3,
          "title": "चञ्चुलाका पापसे भय एवं संसारसे वैराग्य"
        },
        {
          "id": "chapter-04",
          "number": 4,
          "title": "चंचुलाकी प्रार्थनासे ब्राह्मणका उसे पूरा शिवपुराण सुनाना और समयानुसार शरीर छोड़कर शिवलोकमें जा चंचुलाका पार्वतीजीकी सखी होना"
        }
      ]
    }
  ]
}